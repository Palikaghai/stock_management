@model SmartStock.ViewModels.CategoryItemViewModel
@{
    ViewData["Title"] = $"Delete Category - {Model.Name}";
    var hasProducts = Model.ProductCount > 0;
}

<link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/categories.css" asp-append-version="true" />

<section class="page-heading">
    <div>
        <span class="eyebrow">CATALOG / CATEGORIES / DELETE CONFIRMATION</span>
        <h1>Delete Category</h1>
        <p>Review category information and product dependency constraints before deletion.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Cancel &amp; Return
    </a>
</section>

<div class="form-card" style="border-color: @(hasProducts ? "#fdba74" : "#fecaca");">
    <div class="form-card-head" style="background: @(hasProducts ? "#fffaf0" : "#fff5f5");">
        <h2 style="color: @(hasProducts ? "#c2410c" : "#dc2626");">
            <i class="bi @(hasProducts ? "bi-exclamation-octagon-fill" : "bi-trash3-fill") me-2"></i>
            @(hasProducts ? "Category Deletion Restricted" : "Confirm Category Removal")
        </h2>
        <p>
            @(hasProducts ? "This category cannot be deleted until all assigned products are reassigned or removed." : "Are you sure you want to permanently delete this category?")
        </p>
    </div>

    <div class="form-card-body">
        @if (hasProducts)
        {
            <div class="danger-notice" style="background: #fff7ed; border-color: #fed7aa; color: #9a3412;">
                <i class="bi bi-shield-slash-fill" style="color: #ea580c; font-size: 22px;"></i>
                <div>
                    <strong style="font-size: 12px; display: block; margin-bottom: 3px;">Referential Integrity Restriction</strong>
                    This category currently has <strong>@Model.ProductCount product(s)</strong> assigned to it.
                    In accordance with database integrity rules, you must either reassign these products to another category or delete them first before this category can be removed.
                </div>
            </div>
        }
        else
        {
            <div class="danger-notice">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    <strong>Safe for Deletion:</strong> This category has 0 associated products. Deleting it will not affect any active inventory records.
                </div>
            </div>
        }

        <div class="delete-summary">
            <div class="delete-summary-row">
                <dt>Category ID</dt>
                <dd>#@Model.Id</dd>
            </div>
            <div class="delete-summary-row">
                <dt>Category Name</dt>
                <dd>@Model.Name</dd>
            </div>
            <div class="delete-summary-row">
                <dt>Description</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "None" : Model.Description)</dd>
            </div>
            <div class="delete-summary-row">
                <dt>Associated Products</dt>
                <dd>
                    <span class="category-count-badge @(Model.ProductCount == 0 ? "zero" : "")">
                        @Model.ProductCount item(s)
                    </span>
                </dd>
            </div>
            <div class="delete-summary-row">
                <dt>Created Date</dt>
                <dd>@Model.CreatedAt.ToString("MMMM d, yyyy")</dd>
            </div>
        </div>

        <div class="form-actions" style="border-top: 0; padding-top: 0;">
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>

            @if (hasProducts)
            {
                <a class="btn btn-primary" asp-action="Products" asp-route-id="@Model.Id">
                    <i class="bi bi-box-seam"></i> View Associated Products (@Model.ProductCount)
                </a>
            }
            else
            {
                <form method="post" asp-action="Delete" asp-route-id="@Model.Id" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash3"></i> Yes, Delete Category
                    </button>
                </form>
            }
        </div>
    </div>
</div>

