<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · SmartStock</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<aside class="sidebar" id="appSidebar">
    <a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark"><i class="bi bi-box-seam-fill"></i></span><span><b>smartstock</b><small>INVENTORY PLATFORM</small></span></a>
    <div class="nav-caption">WORKSPACE</div>
    <nav class="side-nav" aria-label="Main navigation">
        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a>
        <a class="muted-link" href="#" aria-disabled="true"><i class="bi bi-box"></i> Products</a>
        <a class="muted-link" href="#" aria-disabled="true"><i class="bi bi-tags"></i> Categories</a>
        <a class="muted-link" href="#" aria-disabled="true"><i class="bi bi-truck"></i> Suppliers</a>
        <a class="muted-link" href="#" aria-disabled="true"><i class="bi bi-box-arrow-in-down"></i> Stock IN</a>
        <a class="muted-link" href="#" aria-disabled="true"><i class="bi bi-box-arrow-up-right"></i> Stock OUT</a>
        <a class="muted-link" href="#" aria-disabled="true"><i class="bi bi-arrow-left-right"></i> Transaction History</a>
        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index"><i class="bi bi-file-earmark-bar-graph"></i> Reports</a>
    </nav>
    <div class="sidebar-bottom">
        <div class="nav-caption">ACCOUNT</div>
        <a class="muted-link" href="#" aria-disabled="true"><i class="bi bi-person-circle"></i> Profile</a>
        <a class="muted-link" href="#" aria-disabled="true"><i class="bi bi-box-arrow-right"></i> Logout</a>
        <div class="profile"><span>JD</span><div><b>Jordan Davis</b><small>Inventory manager</small></div></div>
    </div>
</aside>
<div class="main">
    <header class="topbar">
        <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false"><i class="bi bi-list"></i></button>
        <div><small>SMARTSTOCK / OPERATIONS</small><b>@ViewData["Title"]</b></div>
        <div class="top-actions"><span><i class="bi bi-calendar3"></i> <span data-current-date></span></span><span class="avatar">JD</span></div>
    </header>
    <main class="content">@RenderBody()</main>
    <footer>© @DateTime.Today.Year SmartStock <span>Inventory clarity, at a glance.</span></footer>
</div>
<div class="backdrop"></div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
