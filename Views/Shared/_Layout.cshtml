@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
        ?? User.Identity?.Name
        ?? "User";
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity?.Name;
    var initials = string.Join("", displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(part => char.ToUpperInvariant(part[0])));
    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "U";
    }
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · SmartStock</title>
    <script>
        (function () {
            const storedTheme = localStorage.getItem('smartstock-theme');
            document.documentElement.setAttribute('data-theme', storedTheme === 'dark' ? 'dark' : 'light');
        }());
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<aside class="sidebar" id="appSidebar">
    <a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark"><i class="bi bi-box-seam-fill"></i></span><span><b>smartstock</b><small>INVENTORY PLATFORM</small></span></a>
    <div class="nav-caption">WORKSPACE</div>
    <nav class="side-nav" aria-label="Main navigation">
        <a class="@(currentController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index" aria-current="@(currentController == "Dashboard" ? "page" : null)"><i class="bi bi-grid-1x2"></i> Dashboard</a>
        <a class="@(currentController == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index" aria-current="@(currentController == "Products" ? "page" : null)"><i class="bi bi-box"></i> Products</a>
        <a class="@(currentController == "Categories" ? "active" : "")" asp-controller="Categories" asp-action="Index" aria-current="@(currentController == "Categories" ? "page" : null)"><i class="bi bi-tags"></i> Categories</a>
        <a class="@(currentController == "Suppliers" ? "active" : "")" asp-controller="Suppliers" asp-action="Index" aria-current="@(currentController == "Suppliers" ? "page" : null)"><i class="bi bi-truck"></i> Suppliers</a>
        <a class="@(currentController == "StockIn" ? "active" : "")" asp-controller="StockIn" asp-action="Index" aria-current="@(currentController == "StockIn" ? "page" : null)"><i class="bi bi-box-arrow-in-down"></i> Stock IN</a>
        <a class="@(currentController == "StockOut" ? "active" : "")" asp-controller="StockOut" asp-action="Index" aria-current="@(currentController == "StockOut" ? "page" : null)"><i class="bi bi-box-arrow-up-right"></i> Stock OUT</a>
        <a class="@(currentController == "Transactions" ? "active" : "")" asp-controller="Transactions" asp-action="Index" aria-current="@(currentController == "Transactions" ? "page" : null)"><i class="bi bi-arrow-left-right"></i> Transaction History</a>
        <a class="@(currentController == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index" aria-current="@(currentController == "Reports" ? "page" : null)"><i class="bi bi-file-earmark-bar-graph"></i> Reports</a>
    </nav>
    <div class="sidebar-bottom">
        <div class="nav-caption">ACCOUNT</div>
        @if (isAuthenticated)
        {
            <a class="@(currentController == "Account" && currentAction == "Profile" ? "active" : "")" asp-controller="Account" asp-action="Profile" aria-current="@(currentController == "Account" && currentAction == "Profile" ? "page" : null)"><i class="bi bi-person-circle"></i> Profile</a>
            <a class="@(currentController == "Settings" ? "active" : "")" asp-controller="Settings" asp-action="Index" aria-current="@(currentController == "Settings" ? "page" : null)"><i class="bi bi-gear"></i> Settings</a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                <button type="submit" class="logout-link"><i class="bi bi-box-arrow-right"></i> Logout</button>
            </form>
            <div class="profile">
                <span aria-hidden="true">@initials</span>
                <div>
                    <b>@displayName</b>
                    <small>@email</small>
                </div>
            </div>
        }
        else
        {
            <a class="@(currentController == "Account" && currentAction == "Login" ? "active" : "")" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Login</a>
            <a asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus"></i> Create account</a>
        }
    </div>
</aside>
<button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-controls="appSidebar" aria-expanded="false"><i class="bi bi-list"></i></button>
<div class="main">
    <header class="topbar">
        <div><small>SMARTSTOCK / OPERATIONS</small><b>@ViewData["Title"]</b></div>
        <div class="top-actions">
            <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false"><i class="bi bi-moon-stars" aria-hidden="true"></i></button>
            <span class="current-date"><i class="bi bi-calendar3"></i> <span data-current-date></span></span>
            @if (isAuthenticated)
            {
                <div class="profile-menu" data-profile-menu>
                    <button class="profile-menu-trigger" type="button" aria-label="Open profile menu" aria-expanded="false" aria-controls="profileDropdown" data-profile-trigger>
                        <span class="avatar" aria-hidden="true">@initials</span>
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="profile-dropdown" id="profileDropdown" data-profile-dropdown hidden>
                        <div class="profile-dropdown-user">
                            <span class="avatar" aria-hidden="true">@initials</span>
                            <span class="profile-dropdown-identity"><b>@displayName</b><small>@email</small></span>
                        </div>
                        <a asp-controller="Account" asp-action="Profile"><i class="bi bi-person"></i> My Profile</a>
                        <a asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i> Settings</a>
                        <a asp-controller="Account" asp-action="Profile" asp-fragment="change-password"><i class="bi bi-shield-lock"></i> Change Password</a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit"><i class="bi bi-box-arrow-right"></i> Logout</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a class="top-auth-link" asp-controller="Account" asp-action="Login">Login</a>
                <a class="top-auth-link top-auth-primary" asp-controller="Account" asp-action="Register">Create account</a>
            }
        </div>
    </header>
    <main class="content">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        @RenderBody()
    </main>
    <footer>© @DateTime.Today.Year SmartStock <span>Inventory clarity, at a glance.</span></footer>
</div>
<div class="backdrop"></div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
