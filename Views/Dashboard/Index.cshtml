@using System.Text.Json
@model SmartStock.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var displayName = ViewBag.UserFullName as string ?? "User";
    var chartData = JsonSerializer.Serialize(new { categories = Model.CategoryLabels, categoryValues = Model.CategoryValues,
        week = Model.MovementLabels, stockIn = Model.StockInValues, stockOut = Model.StockOutValues,
        valuations = Model.ValuationValues, months = Model.MonthLabels, monthlyIn = Model.MonthlyInValues, monthlyOut = Model.MonthlyOutValues });
}
<section class="page-heading"><div><span class="eyebrow">@DateTime.Today.ToString("dddd, MMMM d, yyyy")</span><h1>Good morning, @displayName ✦</h1><p>Demo inventory snapshot — connect your inventory data source when ready.</p></div><a class="btn btn-primary" asp-controller="Reports" asp-action="Index"><i class="bi bi-file-earmark-bar-graph"></i> View inventory report</a></section>
<section class="stats-grid">
    <article class="stat-card"><div class="stat-top">Total products <span class="stat-icon"><i class="bi bi-box-seam"></i></span></div><div class="stat-value">@Model.TotalProducts</div><div class="stat-note">Products tracked in this demo catalog</div></article>
    <article class="stat-card"><div class="stat-top">Total stock value <span class="stat-icon green"><i class="bi bi-currency-rupee"></i></span></div><div class="stat-value">₹@Model.TotalStockValue.ToString("N0")</div><div class="stat-note">Based on current on-hand stock</div></article>
    <article class="stat-card"><div class="stat-top">Low stock alerts <span class="stat-icon amber"><i class="bi bi-exclamation-triangle"></i></span></div><div class="stat-value">@Model.LowStockCount</div><div class="stat-note">At or below reorder level</div></article>
    <article class="stat-card"><div class="stat-top">Total suppliers <span class="stat-icon violet"><i class="bi bi-truck"></i></span></div><div class="stat-value">@Model.TotalSuppliers</div><div class="stat-note">Active supplier partners</div></article>
</section>
<section class="grid">
    <article class="panel"><div class="panel-head"><div><h2>Category-wise inventory</h2><p>Units available by category</p></div><a class="panel-link" asp-controller="Reports" asp-action="Index" asp-route-reportType="category">View report ↗</a></div><div class="panel-body"><div class="chart"><canvas id="categoryChart" aria-label="Inventory by category"></canvas></div></div></article>
    <article class="panel"><div class="panel-head"><div><h2>Stock IN vs Stock OUT</h2><p>This week’s inventory movement</p></div></div><div class="panel-body"><div class="chart"><canvas id="movementChart" aria-label="Weekly inventory movements"></canvas></div></div></article>
</section>
<section class="grid equal">
    <article class="panel"><div class="panel-head"><div><h2>Stock valuation</h2><p>On-hand cost by category</p></div></div><div class="panel-body"><div class="chart small"><canvas id="valuationChart" aria-label="Stock value by category"></canvas></div></div></article>
    <article class="panel"><div class="panel-head"><div><h2>Monthly inventory movement</h2><p>Units moved over six months</p></div></div><div class="panel-body"><div class="chart small"><canvas id="monthlyChart" aria-label="Monthly inventory in and out"></canvas></div></div></article>
</section>
<section class="panel" style="margin-bottom:15px"><div class="panel-head"><div><h2>Quick actions</h2><p>Jump into your day-to-day workflows</p></div></div><div class="panel-body quick-actions">
    <a class="quick-action" asp-controller="Reports" asp-action="Index"><i class="bi bi-file-earmark-text"></i> Inventory report</a>
    <a class="quick-action" asp-controller="StockIn" asp-action="Index"><i class="bi bi-box-arrow-in-down"></i> Record stock IN</a>
    <a class="quick-action" asp-controller="StockOut" asp-action="Index"><i class="bi bi-box-arrow-up-right"></i> Record stock OUT</a>
    <a class="quick-action" asp-controller="Reports" asp-action="Index" asp-route-reportType="low-stock"><i class="bi bi-exclamation-circle"></i> Low stock report</a>
</div></section>
<section class="grid">
    <article class="panel"><div class="panel-head"><div><h2>Recent transactions</h2><p>Latest inventory activity</p></div><a class="panel-link" asp-controller="Transactions" asp-action="Index">View all</a></div>
        <div class="table-responsive"><table class="data-table"><thead><tr><th>Product</th><th>Reference</th><th>Type</th><th>Quantity</th><th>Date</th></tr></thead><tbody>
        @foreach (var transaction in Model.RecentTransactions) { var product = Model.Products.First(p => p.Id == transaction.ProductId);
            <tr><td class="product">@product.Name<small>@product.Sku</small></td><td>@transaction.Reference</td><td><span class="badge-soft @(transaction.Type == "IN" ? "move-in" : "move-out")">Stock @transaction.Type</span></td><td>@(transaction.Type == "IN" ? "+" : "−")@transaction.Quantity</td><td>@transaction.Date.ToString("MMM d")</td></tr> }
        </tbody></table></div>
    </article>
    <article class="panel"><div class="panel-head"><div><h2>Low stock products</h2><p>Reorder these items soon</p></div><a class="panel-link" asp-controller="Reports" asp-action="Index" asp-route-reportType="low-stock">See all</a></div>
        @if (Model.LowStockProducts.Count == 0) { <div class="empty">All products are above reorder level.</div> } else {
        <div class="table-responsive"><table class="data-table"><thead><tr><th>Product</th><th>In stock</th><th>Reorder at</th><th>Status</th></tr></thead><tbody>
        @foreach (var product in Model.LowStockProducts) { <tr><td class="product">@product.Name<small>@product.Sku</small></td><td>@product.OnHand</td><td>@product.ReorderLevel</td><td><span class="badge-soft">Low stock</span></td></tr> }
        </tbody></table></div> }
    </article>
</section>
<script id="chart-data" type="application/json">@Html.Raw(chartData)</script>
@section Scripts { <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script><script src="~/js/dashboard.js" asp-append-version="true"></script> }
