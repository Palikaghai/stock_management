@model IReadOnlyList<SmartStock.ViewModels.InventoryGroupViewModel>
@{
    ViewData["Title"] = "Suppliers";
}
<section class="page-heading">
    <div>
        <span class="eyebrow">PARTNER DIRECTORY</span>
        <h1>Suppliers</h1>
        <p>Supplier summaries are based on the products currently in your catalog.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Products" asp-action="Create"><i class="bi bi-plus-lg"></i> Add product</a>
</section>
<section class="panel">
    <div class="panel-head"><div><h2>Inventory by supplier</h2><p>@Model.Count suppliers</p></div></div>
    @if (Model.Count == 0)
    {
        <div class="empty">No suppliers yet. Add a product to create the first supplier.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead><tr><th>Supplier</th><th>Products</th><th>Units on hand</th><th>Stock value</th><th>Low stock items</th><th></th></tr></thead>
                <tbody>
                @foreach (var supplier in Model)
                {
                    <tr>
                        <td class="product">@supplier.Name</td>
                        <td>@supplier.ProductCount</td>
                        <td>@supplier.UnitsOnHand</td>
                        <td>₹@supplier.StockValue.ToString("N2")</td>
                        <td>@supplier.LowStockCount</td>
                        <td><a class="btn btn-outline-secondary btn-sm" asp-controller="Products" asp-action="Index" asp-route-supplier="@supplier.Name">View products</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
