@model SmartStock.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · SmartStock</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            const stored = localStorage.getItem('smartstock-theme');
            const theme = stored || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        }());
    </script>
</head>
<body class="auth-body">
    <div class="auth-shell">
        <div class="auth-card auth-card-wide">
            <div class="auth-brand">
                <span class="brand-mark"><i class="bi bi-box-seam-fill"></i></span>
                <div>
                    <strong>SmartStock</strong>
                    <small>Inventory Platform</small>
                </div>
            </div>

            <div class="auth-intro">
                <h1>Create your account</h1>
                <p>Register to start tracking your inventory and stock operations.</p>
            </div>

            <form asp-action="Register" asp-controller="Account" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="field-group">
                    <label asp-for="FullName"></label>
                    <div class="input-with-icon">
                        <i class="bi bi-person"></i>
                        <input asp-for="FullName" class="form-control" autocomplete="name" placeholder="John Doe" />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="field-group">
                    <label asp-for="Email"></label>
                    <div class="input-with-icon">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="field-group">
                    <label asp-for="Password"></label>
                    <div class="input-with-icon input-with-action">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Password" class="form-control password-field" type="password" autocomplete="new-password" placeholder="Create a strong password" />
                        <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="field-group">
                    <label asp-for="ConfirmPassword"></label>
                    <div class="input-with-icon input-with-action">
                        <i class="bi bi-lock-fill"></i>
                        <input asp-for="ConfirmPassword" class="form-control password-field" type="password" autocomplete="new-password" placeholder="Re-enter your password" />
                        <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="auth-row auth-row-compact">
                    <span>Already have an account?</span>
                    <a asp-controller="Account" asp-action="Login" class="text-link">Login</a>
                </div>

                <button type="submit" class="btn btn-primary w-100 auth-submit">Create account</button>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
