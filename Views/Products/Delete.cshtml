@model SmartStock.ViewModels.ProductItemViewModel
@{
    ViewData["Title"] = $"Delete Product - {Model.Name}";
}

<link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />

<section class="page-heading">
    <div>
        <span class="eyebrow">CATALOG / PRODUCTS / DELETE CONFIRMATION</span>
        <h1>Delete Product</h1>
        <p>Review product details carefully before confirming deletion from the catalog.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Cancel &amp; Return
    </a>
</section>

<div class="form-card" style="border-color: #fecaca;">
    <div class="form-card-head" style="background: #fff5f5;">
        <h2 style="color: #dc2626;"><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i> Confirm Product Removal</h2>
        <p>Are you certain you want to permanently delete this product record?</p>
    </div>

    <div class="form-card-body">
        <div class="danger-notice">
            <i class="bi bi-shield-lock-fill"></i>
            <div>
                <strong>Relational Integrity Guard:</strong> If this product has linked inventory movements (Stock IN / Stock OUT), the system will safely reject deletion to protect the historical audit trail.
            </div>
        </div>

        <div class="delete-summary">
            <div class="delete-summary-row">
                <dt>Product ID</dt>
                <dd>#@Model.Id</dd>
            </div>
            <div class="delete-summary-row">
                <dt>Product Name</dt>
                <dd>@Model.Name</dd>
            </div>
            <div class="delete-summary-row">
                <dt>SKU</dt>
                <dd><span class="sku-badge">@Model.Sku</span></dd>
            </div>
            <div class="delete-summary-row">
                <dt>Category</dt>
                <dd>@Model.CategoryName</dd>
            </div>
            <div class="delete-summary-row">
                <dt>Unit Price</dt>
                <dd>₹@Model.UnitPrice.ToString("N2")</dd>
            </div>
            <div class="delete-summary-row">
                <dt>Current On-Hand Stock</dt>
                <dd>@Model.Quantity units</dd>
            </div>
            <div class="delete-summary-row">
                <dt>Reorder Threshold</dt>
                <dd>@Model.ReorderLevel units</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Supplier))
            {
                <div class="delete-summary-row">
                    <dt>Supplier Partner</dt>
                    <dd>@Model.Supplier</dd>
                </div>
            }
        </div>

        <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()
            <div class="form-actions" style="border-top: 0; padding-top: 0;">
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash3"></i> Yes, Delete This Product
                </button>
            </div>
        </form>
    </div>
</div>

