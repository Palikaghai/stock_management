@model SmartStock.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = "Products";
}
<section class="page-heading">
    <div>
        <span class="eyebrow">INVENTORY</span>
        <h1>Products</h1>
        <p>Search products, check stock levels, and manage catalog details.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add product</a>
</section>

<form class="filters" method="get" asp-action="Index">
    <div class="filter-grid product-filter-grid">
        <div class="filter-field">
            <label for="search">Search</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Product name or SKU" />
        </div>
        <div class="filter-field">
            <label for="category">Category</label>
            <select id="category" name="category" class="form-select">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(Model.Category == category)">@category</option>
                }
            </select>
        </div>
        <div class="filter-field">
            <label for="supplier">Supplier</label>
            <select id="supplier" name="supplier" class="form-select">
                <option value="">All suppliers</option>
                @foreach (var supplier in Model.Suppliers)
                {
                    <option value="@supplier" selected="@(Model.Supplier == supplier)">@supplier</option>
                }
            </select>
        </div>
        <div class="filter-actions">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Filter</button>
            <a class="btn btn-outline-secondary" asp-action="Index" title="Clear filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </div>
</form>

<section class="panel">
    <div class="panel-head">
        <div><h2>Product catalog</h2><p>@Model.Products.Count items</p></div>
        <a class="panel-link" asp-controller="Transactions" asp-action="Index">View transaction history</a>
    </div>
    @if (Model.Products.Count == 0)
    {
        <div class="empty">No products match these filters.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead><tr><th>Product</th><th>Category</th><th>Supplier</th><th>On hand</th><th>Reorder at</th><th>Unit cost</th><th></th></tr></thead>
                <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td class="product">@product.Name<small>@product.Sku</small></td>
                        <td>@product.Category</td>
                        <td>@product.Supplier</td>
                        <td>@product.OnHand</td>
                        <td>@product.ReorderLevel</td>
                        <td>₹@product.UnitCost.ToString("N2")</td>
                        <td><a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@product.Id">Edit</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
