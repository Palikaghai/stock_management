@model SmartStock.ViewModels.TransactionListViewModel
@{
    ViewData["Title"] = "Transaction History";
    var products = Model.Products.ToDictionary(product => product.Id);
}
<section class="page-heading">
    <div>
        <span class="eyebrow">AUDIT TRAIL</span>
        <h1>Transaction history</h1>
        <p>Review stock receipts and issues recorded during this application session.</p>
    </div>
    <div class="transaction-actions">
        <a class="btn btn-primary" asp-controller="StockIn" asp-action="Index"><i class="bi bi-box-arrow-in-down"></i> Stock IN</a>
        <a class="btn btn-outline-secondary" asp-controller="StockOut" asp-action="Index"><i class="bi bi-box-arrow-up-right"></i> Stock OUT</a>
    </div>
</section>
<section class="panel">
    <div class="panel-head">
        <div><h2>Inventory movements</h2><p>@Model.Transactions.Count transactions</p></div>
        <div class="transaction-filters">
            <a class="@(string.IsNullOrEmpty(Model.Type) ? "active" : "")" asp-action="Index">All</a>
            <a class="@(Model.Type == "IN" ? "active" : "")" asp-action="Index" asp-route-type="IN">Stock IN</a>
            <a class="@(Model.Type == "OUT" ? "active" : "")" asp-action="Index" asp-route-type="OUT">Stock OUT</a>
        </div>
    </div>
    @if (Model.Transactions.Count == 0)
    {
        <div class="empty">No transactions match this filter.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead><tr><th>Date</th><th>Product</th><th>Type</th><th>Quantity</th><th>Reference</th></tr></thead>
                <tbody>
                @foreach (var transaction in Model.Transactions)
                {
                    var product = products[transaction.ProductId];
                    <tr>
                        <td>@transaction.Date.ToString("MMM d, yyyy h:mm tt")</td>
                        <td class="product">@product.Name<small>@product.Sku</small></td>
                        <td><span class="badge-soft @(transaction.Type == "IN" ? "move-in" : "move-out")">Stock @transaction.Type</span></td>
                        <td>@(transaction.Type == "IN" ? "+" : "−")@transaction.Quantity</td>
                        <td>@transaction.Reference</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
